    {
      "parameters": {
        "jsCode": "// SIGNATURE VERIFICATION DINONAKTIFKAN UNTUK ASSESSMENT.\n// Retell Web Call tetap mengirim header signature, tapi verifikasinya\n// gagal (key mismatch / bukan API key ber-badge \"webhook\"), sehingga\n// workflow berhenti sebelum sampai ke Google Sheets/Telegram.\n// Untuk PRODUCTION nanti: pasang lagi HMAC check dengan API key yang\n// benar (badge \"webhook\" di Retell dashboard), jangan biarkan seperti ini.\n\nconst item = $input.first().json;\nconst parsedBody = typeof item.body === 'string' ? JSON.parse(item.body) : item.body;\nreturn [{ json: { ...item, body: parsedBody, signatureCheck: 'DISABLED_FOR_ASSESSMENT' } }];"
      },
      "name": "Verify Retell Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -416,
        144
      ],
      "id": "c4768b5d-1ee6-43bd-a853-3a79eab63ee7",
      "notes": "Signature check dimatikan sementara untuk assessment - lihat komentar di kode. Aktifkan lagi sebelum production."
    },
    {
      "parameters": {
        "jsCode": "const inputData = $input.first().json;\nconst payload = inputData.body || inputData;\n\nfunction isNonEmpty(obj) {\n  return obj && typeof obj === 'object' && Object.keys(obj).length > 0;\n}\n\n// args_at_root: true di Retell -> argumen fungsi ada LANGSUNG di root payload\nconst args = isNonEmpty(payload.args) ? payload.args\n  : isNonEmpty(payload.parameters) ? payload.parameters\n  : isNonEmpty(payload.call?.custom_variables) ? payload.call.custom_variables\n  : payload;\n\nconst leadId = args.lead_id || null;\nconst phoneNumber = args.phone_number || null;\nconst customerName = (args.customer_name && args.customer_name.trim() !== '')\n  ? args.customer_name.trim()\n  : 'Nasabah (nama tidak tercatat)';\nconst hasKpr = Boolean(args.has_existing_kpr);\nconst currentBank = (args.current_bank && args.current_bank !== '') ? args.current_bank : 'Bank Belum Ditentukan';\nconst kprTenure = Number(args.kpr_tenure_years) || 0;\nconst isInterested = Boolean(args.interest_in_takeover);\n\nlet leadScore = 'COLD_LEAD';\nlet nextAction = 'LOG_ONLY';\n\nif (hasKpr && isInterested) {\n  leadScore = 'HOT_LEAD';\n  nextAction = 'ROUTE_TO_KPR_SPECIALIST_TELEMARKETING';\n} else if (hasKpr && !isInterested) {\n  leadScore = 'WARM_NURTURE';\n  nextAction = 'SEND_EDUCATIONAL_WHATSAPP';\n}\n\nconst LEAD_SCORE_LABELS = { HOT_LEAD: 'HOT LEAD', WARM_NURTURE: 'WARM LEAD', COLD_LEAD: 'COLD LEAD' };\nconst NEXT_ACTION_LABELS = {\n  ROUTE_TO_KPR_SPECIALIST_TELEMARKETING: 'Diarahkan ke Tim Spesialis KPR (Telemarketing)',\n  SEND_EDUCATIONAL_WHATSAPP: 'Kirim WhatsApp Edukasi KPR',\n  LOG_ONLY: 'Hanya dicatat (belum lanjut)'\n};\n\nreturn [{\n  json: {\n    status: 200,\n    message: \"Lead data successfully processed by 99 Group Engine\",\n    data: {\n      leadId,\n      phoneNumber,\n      customerName,\n      hasActiveKPR: hasKpr,\n      currentBank,\n      kprTenureYears: kprTenure,\n      isInterestedInTakeover: isInterested,\n      leadScore,\n      leadScoreLabel: LEAD_SCORE_LABELS[leadScore],\n      nextAction,\n      nextActionLabel: NEXT_ACTION_LABELS[nextAction],\n      processedAt: new Date().toISOString()\n    }\n  }\n}];"
      },
      "name": "JS Lead Scoring & Normalizer1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        144
      ],
      "id": "3bfd1bed-b8b5-44ad-a66e-d4e85ddf1cd1"
    },
