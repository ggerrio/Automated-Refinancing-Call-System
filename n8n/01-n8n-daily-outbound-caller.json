    {
      "parameters": {
        "jsCode": "const DRY_RUN = true;\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const lead = item.json;\n  const fakeCallId = 'CALL-' + Date.now() + '-' + Math.random().toString(36).substr(2, 6);\n  results.push({\n    json: {\n      call_id: fakeCallId,\n      status: 'dry_run_simulated',\n      to_number: lead['No HP'],\n      lead_id: lead['Lead ID'],\n      customer_name: lead['Nama'],\n      simulated_at: new Date().toISOString(),\n      message: `[DRY RUN] Would call ${lead['Nama']} at ${lead['No HP']}`\n    }\n  });\n}\nreturn results;"
      },
